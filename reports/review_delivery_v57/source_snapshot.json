{
  "path": "review/swar-words.html",
  "sha256": "c37a73eb82dc2dc48c900ab7a36af877e0c23c26e173cc2998dfcc0035cf635b",
  "source_utf8": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Swar pronunciation review · Ampixa</title>\n<style>\n:root{--paper:#f0f4f9;--ink:#14263d;--muted:#566779;--line:#ced9e5;--white:#fff;--flag:#ae273c;--flag-bg:#fff0f2;--review:#765813;--review-bg:#fff7df;--accent:#18696c}\n*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 \"Kohinoor Devanagari\",\"Noto Sans Devanagari\",system-ui,sans-serif}button,input,select{font:inherit}button,a,select,input{touch-action:manipulation}button,select,input{color:inherit;background:var(--white);border:1px solid var(--line);border-radius:6px;padding:8px 12px}button{cursor:pointer}button:hover{border-color:var(--accent)}:focus-visible{outline:3px solid #587ca8;outline-offset:3px}a{color:var(--accent)}header,main{max-width:1250px;margin:auto;padding:24px 30px}header{display:flex;justify-content:space-between;align-items:start;gap:24px}h1{font-size:clamp(25px,3.4vw,39px);font-weight:650;line-height:1.18;margin:4px 0 12px;letter-spacing:-.7px}p{max-width:76ch;margin:8px 0}.muted,small{color:var(--muted)}small{font-size:13px}.status{padding:14px 18px;background:#e4edf5;border-radius:6px;margin-bottom:20px}.filters{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 18px}.filters input{flex:1;min-width:150px}.workspace{display:grid;grid-template-columns:260px minmax(0,1fr);gap:24px}.choices{display:flex;flex-direction:column;gap:8px;max-height:76vh;overflow:auto;align-self:start;position:sticky;top:12px}.choice{text-align:left;padding:11px 13px;background:transparent}.choice[aria-current=true]{background:var(--white);border-color:var(--accent);box-shadow:inset 4px 0 var(--accent)}.choice strong{display:block;font-size:15px;font-weight:550}.choice small{display:block;font-size:11px;margin-top:5px}.sample{min-width:0}.sample>h2{font-size:clamp(21px,2.4vw,28px);font-weight:550;line-height:1.8;margin:0 0 12px}.nav{display:flex;gap:10px;align-items:center;margin-bottom:12px}.nav small{margin-left:auto}.reading{background:var(--white);border-radius:8px;padding:18px 20px;margin:14px 0}.reading-title{display:flex;align-items:center;justify-content:space-between;gap:12px}.reading-title h3{font-size:17px;margin:0}.words{font-size:22px;line-height:2.3;margin:12px -3px 8px}.word{padding:2px 5px;margin:1px 2px;border:1px solid transparent;border-radius:4px;background:transparent;line-height:1.8;font-size:inherit}.word.flag{color:var(--flag);background:var(--flag-bg);border-bottom:3px solid var(--flag)}.word.uncertain{background:var(--review-bg);color:var(--review)}.word.untested{color:var(--muted);text-decoration:underline dotted #9aaaba;text-underline-offset:6px}.word.selected{outline:2px solid var(--accent);outline-offset:1px}audio{display:block;width:100%;height:36px;margin:8px 0}.evidence{border-left:3px solid var(--accent);padding:8px 16px;margin-top:10px;font-size:14px}.evidence:empty{display:none}.evidence h4{margin:0 0 6px;font-size:16px}.site{padding:6px 0}.site p{margin:3px 0}.plot{width:100%;height:110px;display:block;margin-top:8px}.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:13px}.key{display:inline-block;width:12px;height:12px;background:var(--flag-bg);border-bottom:3px solid var(--flag);vertical-align:middle;margin-right:5px}.key.amber{background:var(--review-bg);border:1px solid #c8b575}.key.grey{background:transparent;border-bottom:1px dotted #9aaaba}.metrics{margin-top:32px;padding:20px;background:#e4edf5;border-radius:8px}.metrics h2{font-size:21px;margin:0 0 10px}table{border-collapse:collapse;font-size:14px;width:100%;margin:12px 0}td,th{text-align:left;padding:9px;border-bottom:1px solid var(--line)}th{font-weight:550}.table-wrap{overflow:auto}details{margin-top:12px}summary{cursor:pointer;color:var(--accent)}.error{color:var(--flag)}.empty{padding:24px;background:var(--white);border-radius:8px}footer{padding:24px 0;color:var(--muted);font-size:13px}.pill{font-size:12px;background:#e3edf2;padding:3px 8px;border-radius:4px}.reading .pill.flag{color:var(--flag);background:var(--flag-bg)}@media(max-width:760px){header,main{padding:18px 15px}header{display:block}header>a{display:inline-block;margin-top:8px}.workspace{grid-template-columns:1fr;gap:18px}.choices{max-height:180px;position:static;display:grid;grid-template-columns:1fr 1fr}.choice strong{font-size:13px}.reading{padding:15px 13px}.words{font-size:21px}.metrics{padding:15px 12px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}\n</style></head><body>\n<header><div><h1>Hear the changed vowel.</h1><p class=\"muted\">Your Swar picks, compared word by word with the real recording. Select a word to hear its exact interval and inspect the pronunciation evidence.</p></div><a href=\"https://cdjk.fell-truck.ts.net/swar-fresh/\" target=\"_blank\" rel=\"noopener\">Original recordings</a></header>\n<main><div id=\"status\" class=\"status\" role=\"status\">Loading the verified model and recordings…</div><p id=\"playbackNotice\" class=\"error\" role=\"alert\" hidden></p>\n<div class=\"filters\"><select id=\"filter\" aria-label=\"Recording group\"><option value=\"picks\">Your six picks</option><option value=\"flagged\">Other flagged recordings</option><option value=\"all\">All speech recordings</option></select><input id=\"search\" type=\"search\" placeholder=\"Find a word or sentence\" aria-label=\"Find a word or sentence\"></div>\n<div class=\"workspace\"><nav id=\"choices\" class=\"choices\" aria-label=\"Recordings\"></nav><section class=\"sample\"><div class=\"nav\"><button id=\"prev\" aria-label=\"Previous recording\">Previous</button><button id=\"next\" aria-label=\"Next recording\">Next</button><small id=\"position\"></small></div><h2 id=\"sentence\"></h2><p id=\"context\" class=\"muted\"></p><div class=\"legend\"><span><i class=\"key\"></i>Vowel-change flag</span><span><i class=\"key amber\"></i>Uncertain</span><span><i class=\"key grey\"></i>Site not tested</span></div><div id=\"readings\"></div></section></div>\n<section class=\"metrics\"><h2>What has been checked</h2><p id=\"regressions\"></p><p id=\"broaderFlags\"></p><div class=\"table-wrap\"><table><thead><tr><th>Controlled change</th><th>Detected</th><th>Missed</th><th>Sham flags</th><th>Pairs</th></tr></thead><tbody id=\"metrics\"></tbody></table></div><p id=\"evaluationScope\" class=\"muted\"></p><p id=\"qualityFollowup\" class=\"muted\"></p><p id=\"shortAudit\" class=\"muted\"></p><p id=\"voiceInfo\" class=\"muted\"></p><p id=\"referenceSensitivity\" class=\"muted\"></p><p id=\"coverage\" class=\"muted\"></p><details id=\"prosodyAudit\"><summary>Prosody experiments: admission results</summary><p id=\"prosodyResults\"></p><p id=\"prosodyLimits\" class=\"muted\"></p></details><details><summary>Model, coverage and operating limits</summary><p id=\"modelInfo\" style=\"overflow-wrap:anywhere\"></p><p>These small controlled tests do not establish general Hindi-error accuracy. Quality evaluation is particularly limited. “No flag” does not prove a word is correct. Unsupported sounds and untested contrasts remain explicit. The real-versus-itself row is a comparison anchor, not a native false-positive benchmark. Hindi-specific intonation accuracy is unvalidated.</p><p><a href=\"/swar-model\">Download the selected model heads</a> · <a href=\"/swar-validation\">Full validation JSON</a></p></details></section>\n<footer>Read-only private review. Word boundaries and phone paths are model measurements; the two reported errors are development regressions. <a href=\"/comparison\">Earlier TTS source-control experiment</a></footer></main>\n<script>\nconst $=id=>document.getElementById(id),create=(tag,text,cls)=>{const n=document.createElement(tag);if(text!=null)n.textContent=text;if(cls)n.className=cls;return n};\nlet index=[],visible=[],selected=null,cache=new Map(),request=0,report=null;\nconst labels={real:'Real recording',swar:'Swar',a450:'Audio8 comparison'},pct=x=>x==null?'—':(100*x).toFixed(1)+'%';\nfunction updateList(){const q=$('search').value.trim(),mode=$('filter').value;visible=index.filter(r=>(!q||r.text.includes(q)||r.original_text?.includes(q))&&(mode==='all'||mode==='picks'&&r.user_pick||mode==='flagged'&&!r.user_pick&&r.swar_flags>0));visible.sort((a,b)=>{const focus=['real_yt_yt01_005','real_yt_yt01_008'];return (focus.includes(a.id)?focus.indexOf(a.id):-1)<0?(focus.includes(b.id)?1:0):focus.includes(b.id)?focus.indexOf(a.id)-focus.indexOf(b.id):-1});$('choices').replaceChildren();for(const r of visible){const b=create('button',null,'choice');b.dataset.id=r.id;b.append(create('strong',r.text),create('small',r.scored?(r.swar_flags+' Swar word flags · '+r.voice):'Unscored: numeric transcript'));b.onclick=()=>show(r.id);$('choices').append(b)}if(!visible.length){document.querySelectorAll('audio').forEach(cancelWord);selected=null;++request;$('position').textContent='0 of 0';$('prev').disabled=true;$('next').disabled=true;$('readings').replaceChildren(create('p','No matching recordings. Change the filter or search.','empty'));$('sentence').textContent='';$('context').textContent='';return}if(!visible.some(r=>r.id===selected))show(visible[0].id);else markCurrent()}\nfunction markCurrent(){for(const b of $('choices').children)b.setAttribute('aria-current',String(b.dataset.id===selected));const i=visible.findIndex(r=>r.id===selected);$('position').textContent=(i+1)+' of '+visible.length;$('prev').disabled=i<=0;$('next').disabled=i>=visible.length-1}\nasync function show(id){document.querySelectorAll('audio').forEach(cancelWord);selected=id;markCurrent();const token=++request;$('readings').replaceChildren(create('p','Loading this recording…','muted'));try{let r=cache.get(id);if(!r){const response=await fetch('/api/swar-case/'+encodeURIComponent(id));if(!response.ok)throw Error('Recording result is not ready ('+response.status+').');r=await response.json();cache.set(id,r)}if(token!==request)return;$('sentence').textContent=r.text;$('context').textContent=r.user_pick?'One of your six picks. Select a word in any reading.':'Additional same-text recording, outside your six picks.';if(r.transcript_expansion)$('context').textContent+=' Number words use an ASR-corroborated spoken expansion; the original numeric transcript is preserved. Only readings with corroborated numbers are shown.';$('readings').replaceChildren();if(r.original_text){const original=create('details');original.append(create('summary','Original numeric transcript'),create('p',r.original_text));$('readings').append(original)}if(!Object.keys(r.analysis).length){$('readings').append(create('p','This transcript contains ambiguous numeric text. It needs a verified spoken expansion before word scoring.','empty'));return}for(const source of ['swar','real','a450']){const reading=r.analysis[source];if(!reading)continue;const panel=create('article',null,'reading'),head=create('div',null,'reading-title');head.append(create('h3',labels[source]));const flags=reading.words.filter(w=>w.decision==='strong_vowel_change').length;head.append(create('span',source==='real'?'Comparison reference':flags?flags+' word flags':'No strong word flags','pill'+(flags?' flag':'')));const words=create('div',null,'words'),audio=create('audio');audio.controls=true;audio.preload='none';audio.src='/swar-audio/'+id+'/'+source;const detail=create('div',null,'evidence');for(const [i,w] of reading.words.entries()){const cls=w.decision==='strong_vowel_change'?'flag':w.decision==='uncertain'?'uncertain':w.decision==='untested_site'?'untested':'';const b=create('button',w.display||w.word,'word '+cls);b.title=w.word+': '+w.decision.replaceAll('_',' ');b.onclick=()=>{document.querySelectorAll('.word.selected').forEach(n=>n.classList.remove('selected'));b.classList.add('selected');playWord(audio,w.start,w.end);showEvidence(detail,w,reading,r.analysis.real?.words[i],r.analysis.real,source,audio)};words.append(b)}panel.append(head,words,audio,detail);$('readings').append(panel)}}catch(e){$('readings').replaceChildren(create('p',e.message,'error'))}}\nfunction cancelWord(audio){audio.wordPlaybackRequest=(audio.wordPlaybackRequest||0)+1;clearTimeout(audio.wordPlaybackTimer);audio.wordPlaybackTimer=null;audio.ontimeupdate=null;audio.pause()}\nfunction audioEvent(audio,event,trigger){return new Promise((resolve,reject)=>{\n  const done=error=>{clearTimeout(timer);audio.removeEventListener(event,ready);audio.removeEventListener('error',failed);error?reject(error):resolve()};\n  const ready=()=>done(),failed=()=>done(Error(audio.error?.message||'Audio could not be loaded'));\n  const timer=setTimeout(()=>done(Error('Audio '+event+' timed out')),15000);\n  audio.addEventListener(event,ready,{once:true});audio.addEventListener('error',failed,{once:true});\n  if(trigger){try{trigger()}catch(error){done(error)}}\n})}\nasync function playWord(audio,start,end){\n  document.querySelectorAll('audio').forEach(a=>{if(a!==audio)cancelWord(a)});cancelWord(audio);\n  const token=audio.wordPlaybackRequest,current=()=>token===audio.wordPlaybackRequest&&audio.isConnected;\n  $('playbackNotice').hidden=true;\n  try{\n    if(audio.readyState<1)await audioEvent(audio,'loadedmetadata',()=>audio.load());\n    if(!current()){console.debug('Superseded word request before seek');return}\n    audio.currentTime=Math.max(0,start-.03);\n    if(audio.seeking)await audioEvent(audio,'seeked');\n    if(!current()){console.debug('Superseded word request after seek');return}\n    await audio.play();\n    const stop=()=>{if(!current()||audio.paused)return;if(audio.currentTime>=end+.04){audio.pause();audio.wordPlaybackTimer=null;return}audio.wordPlaybackTimer=setTimeout(stop,Math.min(20,Math.max(1,(end+.04-audio.currentTime)*1000)))};\n    stop();\n  }catch(error){\n    if(!current()||error.name==='AbortError'&&audio.paused&&!audio.error){console.debug('Expected word-playback cancellation',error.message);return}\n    $('playbackNotice').textContent='Playback failed: '+error.message;$('playbackNotice').hidden=false;\n  }\n}\nfunction showEvidence(target,w,reading,rw,real,source,audio){\n  target.replaceChildren(create('h4',w.word));\n  if(!w.sites.length){target.append(create('p','No supported Hindi/Nepali vowel contrast was tested here.'));\n    for(const reason of new Set(w.unavailable_reasons||[]))target.append(create('small',reason+' '));}\n  for(const s of w.sites){\n    const box=create('div',null,'site'),kind=s.site.kind==='vowel_deletion'?'Expected vowel may be missing':'Vowel sound may have changed';\n    box.append(create('strong',s.decision==='strong_vowel_change'?kind:s.decision==='uncertain'?'Uncertain vowel contrast':'No strong vowel-change evidence'));\n    const sequence=s.native_ipa_sequence||s.native_phones,nearby=sequence.slice(Math.max(0,s.site.index-1),s.site.index+2).join(' · ');\n    box.append(create('p',s.site.kind==='vowel_deletion'?'Expected sequence: '+nearby+'. The alternative removes this vowel.':'Expected vowel '+s.site.expected+'; competing Hindi-G2P vowel '+s.site.alternative+'.'));\n    if(s.decision==='uncertain'&&(s.features[7]>=0||s.secondary_features?.[7]>=0))box.append(create('p','The reference also favors the reduced form. This site does not establish a new vowel loss relative to it.','muted'));\n    if(s.query_focus){const b=create('button','Replay this sound');b.onclick=()=>playWord(audio,Math.max(0,s.query_focus.start-.06),Math.min(reading.seconds,s.query_focus.end+.06));box.append(b)}\n    const teacher=s.teacher_reference_support;\n    if(teacher){const statement=teacher.decision==='strong_vowel_change'?'Teacher-relative vowel-change flag with '+teacher.qualified_references+' qualified 24-layer teacher reference'+(teacher.qualified_references===1?' (one-reference support).':'s.'):'Teacher-reference check: '+teacher.decision.replaceAll('_',' ')+'.';box.append(create('p',statement,'muted'))}\n    const variation=s.observed_human_variation;\n    if(variation?.status==='observed_in_other_real_recordings'){\n      box.append(create('p','A similar vowel pattern appears in '+variation.cases.length+' other real-word examples. This may reflect contextual or regional variation; Hindi influence remains unconfirmed.','muted'));\n      const example=variation.cases[0],player=create('audio');player.controls=true;player.preload='none';player.src='/swar-audio/'+encodeURIComponent(example.id)+'/real';player.setAttribute('aria-label','Recorded variation example for '+w.word);\n      const replay=create('button','Play a real example');replay.onclick=()=>playWord(player,example.word_start,example.word_end);box.append(replay,player);\n    }\n    const extra=create('details');extra.append(create('summary','Measured evidence'),create('p','Edit-model score '+s.controlled_vowel_change_score.toFixed(3)+'. This is not a probability of Hindi accent.'),create('p','Alternative minus expected path, relative to the real reading: '+s.features[8].toFixed(3)+' per frame.'),create('p','Phone probe 1: '+w.phone_probe_sequence));\n    if(w.secondary_phone_probe_sequence)extra.append(create('p','Phone probe 2: '+w.secondary_phone_probe_sequence));\n    if(s.secondary_features)extra.append(create('p','Second-probe relative path margin: '+s.secondary_features[8].toFixed(3)+' per frame. Probe agreement is corroboration, not independent human truth.'));\n    if(s.query_focus)extra.append(create('small','Replay boundaries are estimated phone-evidence windows.'));\n    box.append(extra);target.append(box)\n  }\n  if(rw&&real&&source!=='real'){\n    target.append(create('p','Measured word duration: '+Math.round((w.end-w.start)*1000)+' ms; real reading '+Math.round((rw.end-rw.start)*1000)+' ms.'));\n    const canvas=create('canvas',null,'plot');target.append(canvas);plotPitch(canvas,w,reading,rw,real);\n    target.append(create('small','Relative pitch shape: blue = selected reading, teal = real. Time is normalized to each word; gaps are unvoiced. This plot is not a Hindi-intonation verdict.'))\n  }\n}\nfunction plotPitch(canvas,w,r,rw,real){const width=Math.max(260,Math.floor(canvas.parentElement.clientWidth-32)),height=110,dpr=window.devicePixelRatio||1;canvas.width=width*dpr;canvas.height=height*dpr;const c=canvas.getContext('2d');c.scale(dpr,dpr);c.strokeStyle='#ced9e5';c.beginPath();c.moveTo(0,55);c.lineTo(width,55);c.stroke();function line(word,reading,color){c.strokeStyle=color;c.lineWidth=2;let active=false;c.beginPath();for(let i=0;i<reading.tracks.times.length;i++){const t=reading.tracks.times[i],v=reading.tracks.pitch_relative_st[i];if(t<word.start||t>word.end)continue;if(v==null){active=false;continue}const x=(t-word.start)/(word.end-word.start)*width,y=55-Math.max(-10,Math.min(10,v))*4;if(active)c.lineTo(x,y);else c.moveTo(x,y);active=true}c.stroke()}line(rw,real,'#18696c');line(w,r,'#305eae')}\ndocument.addEventListener('play',event=>{if(event.target.tagName==='AUDIO')document.querySelectorAll('audio').forEach(a=>{if(a!==event.target)cancelWord(a)})},true);\n$('filter').onchange=updateList;$('search').oninput=updateList;$('prev').onclick=()=>{const i=visible.findIndex(r=>r.id===selected);if(i>0)show(visible[i-1].id)};$('next').onclick=()=>{const i=visible.findIndex(r=>r.id===selected);if(i+1<visible.length)show(visible[i+1].id)};\nasync function refresh(){try{\n  const response=await fetch('/api/swar');if(!response.ok)throw Error('Results API returned '+response.status);const d=await response.json();report=d.model_report;\n  if(!d.actual_report){$('status').textContent='Preparing the vowel model: '+(d.model_status?.phase||d.control_status?.phase||'starting').replaceAll('_',' ')+'.';setTimeout(refresh,5000);return}\n  const a=d.actual_report;$('status').textContent=a.regressions_passed+' of '+a.regressions.length+' reported word errors flagged. '+a.cases_scored+' same-text cases scored; '+a.user_picks_scored+' of your picks are available.';\n  index=d.cases;for(const expansion of report.numeric_expansion_audit?.expansions||[]){const row=index.find(r=>r.id===expansion.id);if(row)row.original_text=expansion.original_text}updateList();$('regressions').textContent='Your reported errors: '+a.regressions.map(r=>r.word+' '+(r.flagged?'flagged':'not flagged')).join('; ')+'. These checks were used in release development and are not independent accuracy estimates.';\n  $('broaderFlags').textContent=report.additional_flag_evidence?'The two reports are development checks. All scored recordings are searched: '+report.additional_flag_evidence.word_flags+' Swar word flags; '+report.additional_flag_evidence.replicated_teacher_supported_words+' also supported against both qualified teacher references. Additional flags remain candidates.':'';\n  const prosody=report.prosody_admission;if(prosody){$('prosodyResults').textContent='No prosody head was admitted. Pitch-only transfers: '+prosody.pitch_reserved.true_positive+'/'+prosody.pitch_reserved.positive_count+' detected, '+prosody.pitch_reserved.false_positive+'/'+prosody.pitch_reserved.negative_count+' Native controls flagged. Word-rhythm transfers: '+prosody.rhythm_reserved.true_positive+'/'+prosody.rhythm_reserved.positive_count+' detected, '+prosody.rhythm_reserved.false_positive+'/'+prosody.rhythm_reserved.negative_count+' Native controls flagged.';$('prosodyLimits').textContent='These controls preserve the Nepali carrier voice and separate pitch from word durations. They test known source-style transfers, not real Hindi-error accuracy. The rhythm word families had previously appeared in the separate pitch audit. Failed heads do not affect the word flags above.'}else $('prosodyAudit').hidden=true;\n  $('metrics').replaceChildren();\n  for(const kind of ['vowel_deletion','vowel_quality']){const m=report.test[kind],v=m.final_gated_decision,tr=create('tr');\n    for(const value of [kind==='vowel_deletion'?'Removed vowel region':'Replaced vowel region',pct(v.recall)+' ('+v.tp+'/'+v.positive_labels+')',v.fn+'/'+v.positive_labels,v.fp+'/'+v.negative_labels,v.positive_labels])tr.append(create('td',value));$('metrics').append(tr)}\n  $('evaluationScope').textContent=report.evaluation_description||'Held-out controlled vowel changes. These measure acoustic edits rather than real Hindi-error accuracy.';\n  if(report.quality_followup){const q=report.quality_followup,n=q.new_physical_all_eligible.counts;$('qualityFollowup').textContent='Quality follow-up: '+n.tp+'/'+n.positive_labels+' replacements detected across '+q.new_physical_word_families+' new word families, with '+n.fp+'/'+n.negative_labels+' sham flags. All source/donor clips in those pairs passed content checks. The quality row pools this with the earlier 4/7 result; the model stayed frozen.'}\n  if(report.short_edit_diagnostic){const x=report.short_edit_diagnostic;$('shortAudit').textContent='Separate short-nucleus cuts: '+x.vowel_deletion.tp+'/'+x.vowel_deletion.positive_labels+' deletion edits and '+x.vowel_quality.tp+'/'+x.vowel_quality.positive_labels+' replacements detected. Those smaller cuts can leave much of the vowel region. Both audits use the same frozen model.'}\n  if(report.voice_audit){const v=report.voice_audit,n=v.native_controls,p=v.pitch_added_effect;$('voiceInfo').textContent='Voice sensitivity: '+n.gain_half.site_flags+'/'+n.gain_half.sites+' gain-change flags; '+n.world_original_f0.site_flags+'/'+n.world_original_f0.sites+' flags after vocoder reconstruction. Pitch shifts of +3/−3 semitones added '+p.world_plus3_semitones.added_flags_over_WORLD0+' and '+p.world_minus3_semitones.added_flags_over_WORLD0+' additional flags, respectively, over that reconstruction. This is a nuisance check, not Hindi-intonation accuracy.'}\n  if(report.deployment_reference_audit){const x=report.deployment_reference_audit;$('referenceSensitivity').textContent='Separate teacher-reference audit across '+x.cases+' cases: '+x.human_word_flags+' human-recording word flags and '+x.swar_word_flags+' Swar word flags. Human flags can be acceptable reductions or reference mistakes; these are disagreements, not verified Hindi errors. The comparison above uses the real same-text recording.'}\n  $('modelInfo').textContent=report.architecture+'. '+(report.training_description||'Control pairs: '+Object.entries(report.control_pairs).map(([k,v])=>v+' '+k).join(', ')).replace(/\\.$/,'')+'. Model SHA-256 '+report.model_sha256+'. Head download requires the documented frozen acoustic encoders and G2P resources.';\n  $('coverage').textContent=a.cases_scored+' of '+a.cases_planned+' speech cases scored. '+(report.word_coverage?report.word_coverage.tested_word_positions+' of '+report.word_coverage.total_word_positions+' word positions have a supported Hindi/Nepali vowel contrast. ':'')+'Other flags remain candidates; only two real errors were supplied. Dotted words have no tested supported contrast. '+(a.unscored_numeric_count??10)+' numeric-containing cases remain unscored.';\n}catch(e){$('status').textContent=e.message;$('status').classList.add('error')}}refresh();\n</script></body></html>\n"
}
