      "source_group": "indicvoices_r/S4257298100347538",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_03_1",
      "text": "बेला भिटा अर्ग्यानिक आइलिफ्ट अन्डर आई क्रिम जेलमा यस अफरका लागि नियम र सर्तहरू के हुन्",
      "speaker_id": "S4257298100347538",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257298100347538_019650.wav",
      "reference_text": "म सङ्गीत सुन्न रुचाउँछु मलाई आधुनिक प्रकारको सङ्गीत मन पर्छ",
      "reference_sha256": "1b6bbab00edeae707ea083083875bc46c74b658cb2ac302084b6e5d8fe10a605",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257298100347538_008056.wav",
