      "source_group": "indicvoices_r/S4259675300304689",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_09_0",
      "text": "अनि राम्रो कम्पनीको सामान लिनुहोस् अनि तपाईँहरूले चलाउनुहोस् तपाईँलाई धेरै लाभदायक हुनेछ",
      "speaker_id": "S4256958500325615",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256958500325615_002961.wav",
      "reference_text": "साथै विशेष गरी सेवा चालक सेवा क्या कार्यलयलाई म अनुरोध गर्दछु",
      "reference_sha256": "41db354a2216301901a494a354c09548ccf38fb8a6ab5ecde6b715c6a4857406",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256958500325615_007699.wav",
      "native_sha256": "86b5c398cd153571fa08bbdb2bbfdd0b19d8f76373b8be426478ec584116885c",
      "source_group": "indicvoices_r/S4256958500325615",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_09_1",
      "text": "आज किनभने आफ्नो भाषा बाँच्यो भने चाहिँ आज सबै कुरो बाँच्ने छ आफ्नो भाषा बाँच्यो भने हाम्रो संस्कृति बाँच्छ",
      "speaker_id": "S4256958500325615",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256958500325615_002961.wav",
      "reference_text": "साथै विशेष गरी सेवा चालक सेवा क्या कार्यलयलाई म अनुरोध गर्दछु",
      "reference_sha256": "41db354a2216301901a494a354c09548ccf38fb8a6ab5ecde6b715c6a4857406",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256958500325615_003386.wav",
      "native_sha256": "c7f2fb1585a5d1cf12a2821ea9e634f8cff55bdc65440675f578b79b5c488c10",
      "source_group": "indicvoices_r/S4256958500325615",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_10_0",
      "text": "मजाले त्यसलाई सुप बनाएर खान सकिन्छ गुन्द्रुकको झोल भन्छ त्यो एकदमै सबैले मनपराउने कुरा हो",
      "speaker_id": "S4259386800339426",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259386800339426_016277.wav",
      "reference_text": "त्यसमा दबाईहरू युज गरेको हुँदैन आफै है मजाले अब अर्ग्यानिक कुराहरू हामीले खान सकिन्छ",
      "reference_sha256": "bb912945821309f163ccfa8d3b369b7eb40fe370bc1ec191e1e31aff744ce370",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259386800339426_016269.wav",
      "native_sha256": "0587bb094e8cba61c26698430ac5b4e2c133a29f324fd80106e859636b6eb501",
      "source_group": "indicvoices_r/S4259386800339426",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_10_1",
      "text": "अघि म चढेको ट्याक्सीमा मेरो वलेट छुट्टिएको छ त्यो चालकलाई फिर्ता बोलाइदिनु होस्",
      "speaker_id": "S4259386800339426",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259386800339426_016277.wav",
      "reference_text": "त्यसमा दबाईहरू युज गरेको हुँदैन आफै है मजाले अब अर्ग्यानिक कुराहरू हामीले खान सकिन्छ",
      "reference_sha256": "bb912945821309f163ccfa8d3b369b7eb40fe370bc1ec191e1e31aff744ce370",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259386800339426_017125.wav",
      "native_sha256": "6a71be9124b51b96f4e74bbb5a871408341a79bd548cd59c7eab942652f26852",
      "source_group": "indicvoices_r/S4259386800339426",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_11_0",
      "text": "उहाँ उहाँहरू बिचरा खेतिमा खटिखाने श्रमिकहरू हुनुहुन्छ जो दार्जिलिङ डिस्ट्रिक्टमा बसेर",
      "speaker_id": "S4259361500382428",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259361500382428_025303.wav",
      "reference_text": "सोह्र बिस निन्नानब्बे एक सौ दस एक सौ बिस",
      "reference_sha256": "6993f282685e2c79be6c1657fe7178c7337629cd35a819f3486796e57f693fb6",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259361500382428_024755.wav",
      "native_sha256": "2e9834164ce6b4a6ebbb8965099339ab0366894aaeb733058bb99a67f5b1c1bf",
      "source_group": "indicvoices_r/S4259361500382428",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_11_1",
      "text": "टिकट किनेर टिकट चाहिँ लाई चाहिँ चिठी टालेर टिकटको व्यवहार गरिएको थियो त्यति बेला",
      "speaker_id": "S4259361500382428",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259361500382428_025303.wav",
      "reference_text": "सोह्र बिस निन्नानब्बे एक सौ दस एक सौ बिस",
      "reference_sha256": "6993f282685e2c79be6c1657fe7178c7337629cd35a819f3486796e57f693fb6",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259361500382428_023370.wav",
      "native_sha256": "afe525189b1aa0417f0cdad4efa329fd283cd40a284fb153934b41edbd36b5ba",
      "source_group": "indicvoices_r/S4259361500382428",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_12_0",
      "text": "प्लिज टेल द पोजिटिभ एक्सपिरियन्स यु ह्याड विथ युअर फर्स्ट प्रोडक्ट",
      "speaker_id": "S4258254800397423",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258254800397423_008408.wav",
      "reference_text": "जीवनमा म आफ्नो परिवार अनि आफ्नो नानीहरूलाई नै बेसी महत्त्व दिन्छु",
      "reference_sha256": "2324e89c0e9fab1255a05f15a9daa3271b1d0f74f964ca76a1e4fd4d78d3d6f1",
      "seed": 0,
      "split": "development",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258254800397423_011455.wav",
      "native_sha256": "6e1b6b6831a6675b3bd5e659931077f391654ab6a253d08187482ccc5eb2d67f",
      "source_group": "indicvoices_r/S4258254800397423",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_12_1",
      "text": "मसँग भन्नपर्दा धार्मिक रीति रिवाजसँग सम्बन्धित गीत सङ्गिनी गीत हो",
      "speaker_id": "S4258254800397423",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258254800397423_008408.wav",
      "reference_text": "जीवनमा म आफ्नो परिवार अनि आफ्नो नानीहरूलाई नै बेसी महत्त्व दिन्छु",
      "reference_sha256": "2324e89c0e9fab1255a05f15a9daa3271b1d0f74f964ca76a1e4fd4d78d3d6f1",
      "seed": 0,
      "split": "development",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258254800397423_009164.wav",
      "native_sha256": "b165771e5d0fcc600f71578b27fcd4b09143f46d30a8369cffed5ba1cd1b7cbc",
      "source_group": "indicvoices_r/S4258254800397423",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_13_0",
      "text": "के तपाईँ मेरो हिमाचल प्रदेश ग्रामीण ब्याङ्क भिसालाई मोबिक्विकबाट हटाउन सक्नुहुन्छ",
      "speaker_id": "S4256933800326415",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256933800326415_008877.wav",
      "reference_text": "मैले गत हप्तादेखि डियोड्रेन्टस प्राप्त गरेको छैन अनुमानित प्राप्ति मिति कहिले हो",
      "reference_sha256": "14dcc7e2d2f417d11db91bf8fae9e767af05952d1b8d17b488a1648b20aaa638",
      "seed": 0,
      "split": "development",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256933800326415_006099.wav",
      "native_sha256": "6fbc38cfd10b6e09490af34e61c147364a50dcfde65d1c704399b379c0d2b0f7",
      "source_group": "indicvoices_r/S4256933800326415",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_13_1",
      "text": "यदि तिनीहरूमध्ये धेरै छन् भने ती सबैलाई भर्नका लागि तालिका बनाउनुहोस्",
      "speaker_id": "S4256933800326415",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256933800326415_008877.wav",
      "reference_text": "मैले गत हप्तादेखि डियोड्रेन्टस प्राप्त गरेको छैन अनुमानित प्राप्ति मिति कहिले हो",
      "reference_sha256": "14dcc7e2d2f417d11db91bf8fae9e767af05952d1b8d17b488a1648b20aaa638",
      "seed": 0,
      "split": "development",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256933800326415_009136.wav",
      "native_sha256": "6c6358b084844385a9eb173bb17cb9a0658904154afdea920b8048216cb9c8f7",
      "source_group": "indicvoices_r/S4256933800326415",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_14_0",
      "text": "एलिसा अनु नम्रता सेलेस्टिना एनेस्थेसिया पुकार",
      "speaker_id": "S4259790200369285",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259790200369285_016321.wav",
      "reference_text": "जम्मू कश्मीर आसाम मेघालय पश्चिम बङ्गाल अनि सिक्किम",
      "reference_sha256": "09716e1dd999ef87a83452a89f9bfc3f801c4b5936aadd6035434ce6fe74828a",
      "seed": 0,
      "split": "development",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259790200369285_006268.wav",
      "native_sha256": "5391c3d7754a4ff317d2bb77f0585becf952e6249ef4598df0cbefe18fe26078",
      "source_group": "indicvoices_r/S4259790200369285",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_14_1",
      "text": "कृपया अमेरिकामा आप्रवासन कानुनबारे यस हप्ताको समाचार फेला पार्नुहोस्",
      "speaker_id": "S4259790200369285",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259790200369285_016321.wav",
      "reference_text": "जम्मू कश्मीर आसाम मेघालय पश्चिम बङ्गाल अनि सिक्किम",
      "reference_sha256": "09716e1dd999ef87a83452a89f9bfc3f801c4b5936aadd6035434ce6fe74828a",
      "seed": 0,
      "split": "development",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259790200369285_009517.wav",
      "native_sha256": "f041f9578a2a1460bdc26cf6c43162cb70dc697bc4c6dc5dbba4decf4a3c59e7",
      "source_group": "indicvoices_r/S4259790200369285",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_15_0",
      "text": "त्यस्तै तरिकाले ओडोनिल राखेर त्यहाँ",
      "speaker_id": "S4258147000367444",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258147000367444_016985.wav",
      "reference_text": "कति मूर्ख छ कति ज्ञानी छ र कस्ता कस्ता बिमारहरूले पीडित छन्",
      "reference_sha256": "15ed78181b636b5435f43f185992b43025c7684412bd030a52bf288a0ce1d28e",
      "seed": 0,
      "split": "development",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258147000367444_007315.wav",
      "native_sha256": "20fdc6b6075f588ada99d3225a7683e14dc19e74ee49c2624689154e9ca7cee4",
      "source_group": "indicvoices_r/S4258147000367444",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_15_1",
      "text": "सय वर्ष वा सो भन्दा पुराना रुखलाई सम्पदाको दर्जा दिइएको छ",
      "speaker_id": "S4258147000367444",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258147000367444_016985.wav",
      "reference_text": "कति मूर्ख छ कति ज्ञानी छ र कस्ता कस्ता बिमारहरूले पीडित छन्",
      "reference_sha256": "15ed78181b636b5435f43f185992b43025c7684412bd030a52bf288a0ce1d28e",
      "seed": 0,
      "split": "development",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258147000367444_011302.wav",
      "native_sha256": "6aeca49a1c88c5af69478a22aed36834f836c2a78b0cba366c0a487935a4e993",
      "source_group": "indicvoices_r/S4258147000367444",
      "review_status": "unreviewed"
    }
  ],
  "clips": [
