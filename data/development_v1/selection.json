      "source_group": "indicvoices_r/S4257298100347538",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_04_0",
      "text": "बाँकुरा बिरभुम कुचबिहार दक्षिण दिनाजपुर मुर्सिदाबाद",
      "speaker_id": "S4258716800392755",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258716800392755_018420.wav",
      "reference_text": "मैले तपाईँहरूको कालिम्पोङ ट्राभल एजेन्सीबाट एउटा गाडी बुक गरेको थिएँ अनि",
      "reference_sha256": "f8e07c2a2204536aa7eabd42651434d166948a1c393cf1dc861132da0e36a72b",
      "seed": 0,
      "split": "train",
