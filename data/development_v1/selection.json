      "source_group": "indicvoices_r/S4259477200361463",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_05_1",
      "text": "जीवन धान्न त मैले स्वयम् मेरो बिचारमा त त्यति गाह्रो छैन जस्तो मलाई लाग्दछ धन्यवाद",
      "speaker_id": "S4259477200361463",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259477200361463_015355.wav",
      "reference_text": "बाल्यकालमा हामी सबै मिली स्कुलको कुना काप्चामा गइ",
      "reference_sha256": "b3ce03a672bcb6eaf9859682766953f05055ade8277e6c23afd1b00efa038247",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259477200361463_009761.wav",
      "native_sha256": "6ee9cabde7108253950992c797321f22b80461269b8bbaa919154744123ddc92",
      "source_group": "indicvoices_r/S4259477200361463",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_06_0",
      "text": "वाहकको रूमा पनि हेर्ने गरिन्छ र विशेष गरेर मलाई मनपर्ने ए चरामा चाहिँ काग पनि रहेको छ",
      "speaker_id": "S4257387500340373",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257387500340373_011237.wav",
      "reference_text": "ब यसको व्याकरण छुट्टै एउटा मौलिकतामा नेपाली भाषा आजको समय स्थितिसम्म आइपुगेको छ",
      "reference_sha256": "68c1e148215f30f0a62f1092440ea42fb4eb924e654755763110a9ba3aeae7d1",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257387500340373_012642.wav",
      "native_sha256": "94d1e92bc431b8ea9038f6840bde6a7f94c47d6a83ed9ff3ebcb7e5cb9ef4dc4",
      "source_group": "indicvoices_r/S4257387500340373",
      "review_status": "unreviewed"
    },
    {
      "id": "dev_06_1",
      "text": "परेवा लाहाँचे अनि डाँफे मुनाल हुकुस",
      "speaker_id": "S4257387500340373",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257387500340373_011237.wav",
      "reference_text": "ब यसको व्याकरण छुट्टै एउटा मौलिकतामा नेपाली भाषा आजको समय स्थितिसम्म आइपुगेको छ",
      "reference_sha256": "68c1e148215f30f0a62f1092440ea42fb4eb924e654755763110a9ba3aeae7d1",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257387500340373_012640.wav",
