      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "7cc2b01e0b419f404afb3ab6",
      "system": "native_recording",
      "sentence_id": "dev_00_1",
      "speaker_id": "S4259065500397435",
      "text": "चौधको दिउँसो के छ ताकि म दुई बर्से जम्ल्याहाहरूसित जान सकूँ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259065500397435_000922.wav",
      "sha256": "805fe5b466b5bdc73ad392fb97096258b493d6b7575a9437cce6a76f5f52165b",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "514df44180ccc41ffda020a6",
      "system": "native_recording",
      "sentence_id": "dev_01_0",
      "speaker_id": "S4257751100369637",
      "text": "हाम्रो समुदायमा अभ्यासमा रहेका परम्परागत कृषि अभ्यासहरूको बारेमा बताउनु पर्दा",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257751100369637_006521.wav",
      "sha256": "dd8980c3a7c7a8775dee78781286b8bee3052cb93efa4a2137604ea4a0dcae8c",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "c8ba8c6e911e5695576376c2",
      "system": "native_recording",
      "sentence_id": "dev_01_1",
      "speaker_id": "S4257751100369637",
      "text": "जस्तै अब दौरा सुरुवालहरू ल लगाउँछन् हैन खुकुरी भिर्छन् खुकुरी भिर्ने चलन छ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257751100369637_015616.wav",
      "sha256": "a69631c52e5ab6e9e138dff139eebb02616ec671b1a755e825b54806ee6ac88a",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "d9e0c0db2faa39e7d48cd168",
      "system": "native_recording",
      "sentence_id": "dev_02_0",
      "speaker_id": "S4258453800348915",
      "text": "जुम्बा भन्ने एउटा डान्स छ त्यो हेरेर पनि हामीलाई राम्रो लाग्छ मतलब हाम्रो",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258453800348915_000984.wav",
      "sha256": "9df06fc848cf179e5cd8268467e16918cc970e65a5b90637ea74ef1c92593e06",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "69ebd8a5b644b18f456062bb",
      "system": "native_recording",
      "sentence_id": "dev_02_1",
      "speaker_id": "S4258453800348915",
      "text": "दार्जिलिङ कालिम्पोङ मालदा जलपाइगुडी अलिपुरद्वार",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258453800348915_000710.wav",
      "sha256": "d9b4816254bbe9f2b2ba599784878c6bb7cea33c4eabcc1246cdc7dc808a4648",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "3790495a723b12db8d61118f",
      "system": "native_recording",
      "sentence_id": "dev_03_0",
      "speaker_id": "S4257298100347538",
      "text": "यी सेवा संस्थानहरू स्वस्थ मुद्धाबारे अनि समाजको उत्थानबारे काम गर्ने गर्दछ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257298100347538_019317.wav",
      "sha256": "6bf667c45fd1e995854e5b8a2cef7eb918e54a52c07e35068e2add4bcbc3bc25",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "34c64fa5f4f78c3f9f3ef7fd",
      "system": "native_recording",
      "sentence_id": "dev_03_1",
      "speaker_id": "S4257298100347538",
      "text": "बेला भिटा अर्ग्यानिक आइलिफ्ट अन्डर आई क्रिम जेलमा यस अफरका लागि नियम र सर्तहरू के हुन्",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257298100347538_008056.wav",
      "sha256": "ea99ba59e92fbf3e1b148db136080f05c4ce755d6275e8c813dbda9082938ea6",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "96666fa5fdd3f5f4b922fdba",
      "system": "native_recording",
      "sentence_id": "dev_04_0",
      "speaker_id": "S4258716800392755",
      "text": "बाँकुरा बिरभुम कुचबिहार दक्षिण दिनाजपुर मुर्सिदाबाद",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258716800392755_016889.wav",
      "sha256": "a1727cc318e3b0021f9779dbc356bed1b7d8f409c186998dd23a5fbd80622489",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "d11bc15636014bede0252a30",
      "system": "native_recording",
      "sentence_id": "dev_04_1",
      "speaker_id": "S4258716800392755",
      "text": "मलाई चाहिँ पौडी खेल्नु क्रिकेट खेल्नु ट्रेकिङ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258716800392755_014193.wav",
      "sha256": "7228dab95ea11b7ceb1cd1cc1ca0f9c4b4358152e46346111146ce8f5c99c72c",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "99d907546442cd2e19050077",
      "system": "native_recording",
      "sentence_id": "dev_05_0",
      "speaker_id": "S4259477200361463",
      "text": "हुँदा हुँदै धेरै परिवर्तन आउँदै गए र अहिले पनि म तपाईँको यो",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259477200361463_003931.wav",
      "sha256": "44e6b84af7de472b71756546aa2a4f8551e86c64e7d15484e9c095023e6aad95",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "3fcb90fcd07d50d029fa673c",
      "system": "native_recording",
      "sentence_id": "dev_05_1",
      "speaker_id": "S4259477200361463",
      "text": "जीवन धान्न त मैले स्वयम् मेरो बिचारमा त त्यति गाह्रो छैन जस्तो मलाई लाग्दछ धन्यवाद",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259477200361463_009761.wav",
      "sha256": "6ee9cabde7108253950992c797321f22b80461269b8bbaa919154744123ddc92",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "e9b166943a30a002c1e2e0dd",
      "system": "native_recording",
      "sentence_id": "dev_06_0",
      "speaker_id": "S4257387500340373",
      "text": "वाहकको रूमा पनि हेर्ने गरिन्छ र विशेष गरेर मलाई मनपर्ने ए चरामा चाहिँ काग पनि रहेको छ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257387500340373_012642.wav",
      "sha256": "94d1e92bc431b8ea9038f6840bde6a7f94c47d6a83ed9ff3ebcb7e5cb9ef4dc4",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "20d3faa2b05ea2804da490fc",
      "system": "native_recording",
      "sentence_id": "dev_06_1",
      "speaker_id": "S4257387500340373",
      "text": "परेवा लाहाँचे अनि डाँफे मुनाल हुकुस",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257387500340373_012640.wav",
      "sha256": "dd5b23521b27bff4aec2175a584c2c1979a531f6f779cec1ad5039d6391145f9",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "32aea2d91ca5babc42c5fd7e",
      "system": "native_recording",
      "sentence_id": "dev_07_0",
      "speaker_id": "S4257689200333878",
      "text": "दार्जिलिङ जिल्लामा मुख्य प्राकृतिक स्रोत वन जङ्गल चिया उद्योग",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257689200333878_021257.wav",
      "sha256": "1f0e6a0bdd00846ac145bfc4577a9f71673cdf3663b37085f51149d241f954a4",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "4b2ef29b5574cccdef2810e1",
      "system": "native_recording",
      "sentence_id": "dev_07_1",
      "speaker_id": "S4257689200333878",
      "text": "मलाई धेरै थरीका कार्डहरू थाहा छ जस्तै डेबिट कार्ड क्रेडिट कार्ड",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4257689200333878_022422.wav",
      "sha256": "1244a49a1d277dd0fffd522f26ca0e1da6ab23faad62a76c34cd9c87adbed727",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "35ead24aa2aad15843fe3323",
      "system": "native_recording",
      "sentence_id": "dev_08_0",
      "speaker_id": "S4259675300304689",
      "text": "यस उदाहरणका लागि यो शुल्कमा सात सौ पचास डलर अतिरिक्त लागत दाबी गर्दछ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259675300304689_014859.wav",
      "sha256": "929b8d73053f59fde7a3eb32f4630a41e2132d5561e450fced7e60fec3b79218",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "da01af38a74bcd19b256a010",
      "system": "native_recording",
      "sentence_id": "dev_08_1",
      "speaker_id": "S4259675300304689",
      "text": "चोलामण्डलम फाइनेन्सबाट सम्पत्ति विरुद्ध ऋणका लागि रिमाइन्डर मेटाउनुहोस्",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259675300304689_007002.wav",
      "sha256": "acc0e97484f9eca38b4a7e10c7147854cf98e6d80b740f25895c1b20369faf73",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "ed6548a15a1f1d2c837e5774",
      "system": "native_recording",
      "sentence_id": "dev_09_0",
      "speaker_id": "S4256958500325615",
      "text": "अनि राम्रो कम्पनीको सामान लिनुहोस् अनि तपाईँहरूले चलाउनुहोस् तपाईँलाई धेरै लाभदायक हुनेछ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256958500325615_007699.wav",
      "sha256": "86b5c398cd153571fa08bbdb2bbfdd0b19d8f76373b8be426478ec584116885c",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "458d52a1bda9885bf8b874b7",
      "system": "native_recording",
      "sentence_id": "dev_09_1",
      "speaker_id": "S4256958500325615",
      "text": "आज किनभने आफ्नो भाषा बाँच्यो भने चाहिँ आज सबै कुरो बाँच्ने छ आफ्नो भाषा बाँच्यो भने हाम्रो संस्कृति बाँच्छ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256958500325615_003386.wav",
      "sha256": "c7f2fb1585a5d1cf12a2821ea9e634f8cff55bdc65440675f578b79b5c488c10",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "d43b4bf88f4522699d1262dd",
      "system": "native_recording",
      "sentence_id": "dev_10_0",
      "speaker_id": "S4259386800339426",
      "text": "मजाले त्यसलाई सुप बनाएर खान सकिन्छ गुन्द्रुकको झोल भन्छ त्यो एकदमै सबैले मनपराउने कुरा हो",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259386800339426_016269.wav",
      "sha256": "0587bb094e8cba61c26698430ac5b4e2c133a29f324fd80106e859636b6eb501",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "5db322951525d2c657ffbaec",
      "system": "native_recording",
      "sentence_id": "dev_10_1",
      "speaker_id": "S4259386800339426",
      "text": "अघि म चढेको ट्याक्सीमा मेरो वलेट छुट्टिएको छ त्यो चालकलाई फिर्ता बोलाइदिनु होस्",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259386800339426_017125.wav",
      "sha256": "6a71be9124b51b96f4e74bbb5a871408341a79bd548cd59c7eab942652f26852",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "c00e362a7ecf680db38a31dd",
      "system": "native_recording",
      "sentence_id": "dev_11_0",
      "speaker_id": "S4259361500382428",
      "text": "उहाँ उहाँहरू बिचरा खेतिमा खटिखाने श्रमिकहरू हुनुहुन्छ जो दार्जिलिङ डिस्ट्रिक्टमा बसेर",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259361500382428_024755.wav",
      "sha256": "2e9834164ce6b4a6ebbb8965099339ab0366894aaeb733058bb99a67f5b1c1bf",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "ff62207fa0fd63252133fb6c",
      "system": "native_recording",
      "sentence_id": "dev_11_1",
      "speaker_id": "S4259361500382428",
      "text": "टिकट किनेर टिकट चाहिँ लाई चाहिँ चिठी टालेर टिकटको व्यवहार गरिएको थियो त्यति बेला",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259361500382428_023370.wav",
      "sha256": "afe525189b1aa0417f0cdad4efa329fd283cd40a284fb153934b41edbd36b5ba",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "6b25cf5ae4ed6be538ed2ba9",
      "system": "native_recording",
      "sentence_id": "dev_12_0",
      "speaker_id": "S4258254800397423",
      "text": "प्लिज टेल द पोजिटिभ एक्सपिरियन्स यु ह्याड विथ युअर फर्स्ट प्रोडक्ट",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258254800397423_011455.wav",
      "sha256": "6e1b6b6831a6675b3bd5e659931077f391654ab6a253d08187482ccc5eb2d67f",
      "split": "development",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "7a6404028773e04da4e650e9",
      "system": "native_recording",
      "sentence_id": "dev_12_1",
      "speaker_id": "S4258254800397423",
      "text": "मसँग भन्नपर्दा धार्मिक रीति रिवाजसँग सम्बन्धित गीत सङ्गिनी गीत हो",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258254800397423_009164.wav",
      "sha256": "b165771e5d0fcc600f71578b27fcd4b09143f46d30a8369cffed5ba1cd1b7cbc",
      "split": "development",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "bb325812b672750e72bf647c",
      "system": "native_recording",
      "sentence_id": "dev_13_0",
      "speaker_id": "S4256933800326415",
      "text": "के तपाईँ मेरो हिमाचल प्रदेश ग्रामीण ब्याङ्क भिसालाई मोबिक्विकबाट हटाउन सक्नुहुन्छ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256933800326415_006099.wav",
      "sha256": "6fbc38cfd10b6e09490af34e61c147364a50dcfde65d1c704399b379c0d2b0f7",
      "split": "development",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "5be479d8419978e772e7984d",
      "system": "native_recording",
      "sentence_id": "dev_13_1",
      "speaker_id": "S4256933800326415",
      "text": "यदि तिनीहरूमध्ये धेरै छन् भने ती सबैलाई भर्नका लागि तालिका बनाउनुहोस्",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4256933800326415_009136.wav",
      "sha256": "6c6358b084844385a9eb173bb17cb9a0658904154afdea920b8048216cb9c8f7",
      "split": "development",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "0c585107cfe11d4bf5267d81",
      "system": "native_recording",
      "sentence_id": "dev_14_0",
      "speaker_id": "S4259790200369285",
      "text": "एलिसा अनु नम्रता सेलेस्टिना एनेस्थेसिया पुकार",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259790200369285_006268.wav",
      "sha256": "5391c3d7754a4ff317d2bb77f0585becf952e6249ef4598df0cbefe18fe26078",
      "split": "development",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "da525606848feac541c1030a",
      "system": "native_recording",
      "sentence_id": "dev_14_1",
      "speaker_id": "S4259790200369285",
      "text": "कृपया अमेरिकामा आप्रवासन कानुनबारे यस हप्ताको समाचार फेला पार्नुहोस्",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259790200369285_009517.wav",
      "sha256": "f041f9578a2a1460bdc26cf6c43162cb70dc697bc4c6dc5dbba4decf4a3c59e7",
      "split": "development",
      "automatic_leakage_label": null
    },
    {
      "clip_id": "903b084be94273b371c532e3",
      "system": "native_recording",
      "sentence_id": "dev_15_0",
      "speaker_id": "S4258147000367444",
      "text": "त्यस्तै तरिकाले ओडोनिल राखेर त्यहाँ",
      "audio": "/Volumes/T9/indicvoices_r_ne/audio/S4258147000367444_007315.wav",
      "sha256": "20fdc6b6075f588ada99d3225a7683e14dc19e74ee49c2624689154e9ca7cee4",
      "split": "development",
      "automatic_leakage_label": null
    },
