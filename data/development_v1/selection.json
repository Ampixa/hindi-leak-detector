  "jobs": [
    {
      "id": "dev_00_0",
      "text": "त्यस पश्चात् त मेरो मूलवासी चाहिँ म दार्जिलङको हो होइन दार्जिलिङकोमा गए पछि चाहिँ",
      "speaker_id": "S4259065500397435",
      "reference_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259065500397435_005809.wav",
      "reference_text": "मेरो पेटिएम वालेट सक्रिय गर्न कृपया मेरो प्यान कार्ड विवरणहरू भर्नुहोस्",
      "reference_sha256": "b4dbd4e331d85f74be889c3f7e1670dafea35afcdf690388bb0827e625b8b949",
      "seed": 0,
      "split": "train",
      "native_audio": "/Volumes/T9/indicvoices_r_ne/audio/S4259065500397435_022577.wav",
