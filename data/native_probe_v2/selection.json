  ],
  "jobs": [
    {
      "id": "probe_v2_00",
      "text": "यस विवादको भँगालो छुटेपछि छुट्टीको महत्त्व केही शताब्दीहरूको लागि घटेर गयो",
      "speaker_id": "S4259085700325035",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_01",
      "text": "वृद्धहरूको निम्ति ओल्ड एज होमहको सुविधाहरू बनाइएको छैन इत्यादि",
      "speaker_id": "S4257018100398290",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_02",
      "text": "र अघि मैले भनिहाले उनलाई अब त्यसैले अब पहाड के गान्धी भनेर पनि भनिन्थ्यो",
      "speaker_id": "S4259279700316061",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_03",
      "text": "दार्जीलिङ कालिम्पोङ जलपाइगुडी अलिपुरद्वार मालदा",
      "speaker_id": "S4259326600373607",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_04",
      "text": "जग्गा जग्गा भएको कारणले गर्दा कतिवटा जग्गाको मलाई त्यस्तो थाहा त छैन तर अब त्यो जगाहरूमा",
      "speaker_id": "S4257279900309919",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_05",
      "text": "ए हुन्छ अलिक छिटो ल्याइदिनुहोस् ल मलाई अघि अर्डर गेरको यहाँ मेरो साथीहरू आएको छ अन्त खाना पर्खिरहेको हामी",
      "speaker_id": "S4259445500306484",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_06",
      "text": "भूमिका सुब्बा प्रतिभा दर्नाल सुमित्र दर्नाल",
      "speaker_id": "S4257741500304512",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_07",
      "text": "वेस्ट बेङ्गाल सिक्किम अनि मणिपुर आसम नागाल्यान्ड",
      "speaker_id": "S4258405200335282",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_08",
      "text": "सिडनी पेरिस टोकियो न्युयोर्क हङकङ",
      "speaker_id": "S4257391800340504",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_09",
      "text": "अनि त्यो खाना पाएर जब मैले खोलेर हेरेँ त्यो खाना साँच्चै तातोतातो थियो र मैले खान सुरु गरेँ",
      "speaker_id": "S4259333900344578",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_10",
      "text": "तुसारोहरू बिहान झरेको हुन्छ पानी पनि चिसो एकदमै चिसो पानी हुन्छ",
      "speaker_id": "S4257177400338821",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_11",
      "text": "अब त्यही हो मान्छेले सरकारी काम पाएन पाएन भने पनि अब प्राइभेट काम गरेरै अब मान्छेले जीविका चलाउँछ है यति नै हो",
      "speaker_id": "S4258785100392834",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_12",
      "text": "भारत नेपाल भुटान अमेरिका फ्रान्स",
      "speaker_id": "S4258012700311274",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_13",
      "text": "पनि उयो चाहिन्थ्यो फलामको कोइला लगाएर उयो लुगाहरू प्रेस गर्दाखेरि त्यसरी गर्नु पर्थ्यो",
      "speaker_id": "S4257482900307073",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_14",
      "text": "हाम्रो क्षेत्रमा लोकगीतहरू चलिरहेको चाहिँ अब अनि अरू त यादै भएन बिर्सेँछु",
      "speaker_id": "S4258124900316554",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_15",
      "text": "कोरोना भाइरस बिमा बिमाको लागि बिमित रकम रुपिँया तिन हजार चयन गर्नुहोस्",
      "speaker_id": "S4259460700361524",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_16",
      "text": "अब अहिले चाहिँ पानी एकदमै उनै अहिले वेदरको फिक्सै छैन जति बेला पनि केही पनि हुनसक्छ अब",
      "speaker_id": "S4257727300382701",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_17",
      "text": "अनि त्यहाँबाट सागसब्जी है अरू मकैहरूको लागि चाहिँ एकदमै राम्रो छ है हाम्रो अब अलैँचीहरू पनि लगाउँछ अलैँचीहरू पनि",
      "speaker_id": "S4259300900382367",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_18",
      "text": "एउटा खेलेकोमा हामीले उयो अनुभव हामीले त्यो गहिरोमा चाहिँ खेल्नुभएन त्यस्तोमा चाहिँ अलिक सचेत भएर खेल्नुपऱ्यो नि त हामीले",
      "speaker_id": "S4257734800306057",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_19",
      "text": "ग्रान्ड स्लाम प्रतियोगितामा खेल्ने पहिलो भारतीय महिला निरूपमा वैद्यनाथन पनि राज्यकै हुन्",
      "speaker_id": "S4258145700306807",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_20",
      "text": "आफूले पठाएको खबर चाँडै पुग्नेछ साथै आफूलाई पनि सजिलो पर्द्छ",
      "speaker_id": "S4259382400392883",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_21",
      "text": "मलाई चाहिँ खाना चाहिँ एकदम समय दिएर नै पकाएको पकाउनु मन लाग्छ र मलाई एकदमै साह्रो परेको खाना",
      "speaker_id": "S4258134900316977",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_22",
      "text": "कुखुराहरू निस्किएको छ गाउँ घरमा सबैले पालिरहेको छ मेरोमा चाहिँ अहिले अब घरको कुखुरा लोकल कुखुरा छ",
      "speaker_id": "S4259099900302234",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_23",
      "text": "मैले आजसम्म त्यस्तो ठुलो मूर्ति वा कला सृजना गरेकी छुइनँ",
      "speaker_id": "S4257592000350688",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_24",
      "text": "र अति नै सबैजना घरपरिवारले पनि मनपरायो मलाई झन् अति नै मनपरेर अहिले पनि मैले त्यो ज्याकेट लगाइरहेको छु",
      "speaker_id": "S4259806300383273",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_25",
      "text": "धेरै जानकारी प्रस्तुत गर्नबाट बच्न आफ्नो परिचय एक अनुच्छेद भन्दा कम्तीमा राख्नुहोस्",
      "speaker_id": "S4257775500306176",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_26",
      "text": "म जातको नेवार परेकोले नेवारहरूको विधि एउटा अचम्मको पो छ क्या",
      "speaker_id": "S4259303500373494",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_27",
      "text": "म मेरो वस्तु सूचीबाट एभिटी चिया खारेज गर्न चाहन्छु",
      "speaker_id": "S4257799100369302",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_28",
      "text": "अन्त अब के गर्नु अब स्याहार्नै पऱ्यो सानो नानी सानो छ हो",
      "speaker_id": "S4257893600334805",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_29",
      "text": "एक हजार दुई हजार तिन हजार चार हजार पाँच हजार",
      "speaker_id": "S4258193000306125",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_30",
      "text": "के म आज दिनको अन्त्यसम्ममा बन्सिवाला पेठा रोयल मिक्स प्राप्त गर्नसक्छु",
      "speaker_id": "S4258521300379169",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    },
    {
      "id": "probe_v2_31",
      "text": "संसारमा भएको विभिन्न जातिहरू कसरी बसोबास गर्छन् र त्यहाँको कल्चरहरू मलाई सबै नै जान्नु मन छ है",
      "speaker_id": "S4258700800392918",
      "split": "reserved_evaluation",
      "category": "fresh_native_negative_proxy"
    }
  ],
