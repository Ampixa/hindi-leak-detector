      "sentence_id": "dev_04_1",
      "speaker_id": "S4258716800392755",
      "text": "मलाई चाहिँ पौडी खेल्नु क्रिकेट खेल्नु ट्रेकिङ",
      "audio": "audio/dev_04_1.wav",
      "sha256": "697cd72a745b9bfa547899402027413d1d78f2e7ee48a61b5240bf561c532672",
      "split": "train",
