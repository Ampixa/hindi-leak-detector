    },
    {
      "clip_id": "c5af38ff9e7be4af1e0f83a3",
      "system": "audio8_r3",
      "sentence_id": "dev_05_0",
      "speaker_id": "S4259477200361463",
      "text": "हुँदा हुँदै धेरै परिवर्तन आउँदै गए र अहिले पनि म तपाईँको यो",
      "audio": "audio/dev_05_0.wav",
      "sha256": "14051e0d64b500ae12bc2d3e18b6bee9d74db0f89ec2d61af8db375d368bd64c",
      "split": "train",
      "automatic_leakage_label": null
    },
    {
