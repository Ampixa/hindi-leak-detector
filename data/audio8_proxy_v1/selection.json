      "clip_id": "a1825a92687ba85d4fd9ef2c",
      "system": "audio8_r3",
      "sentence_id": "dev_06_1",
      "speaker_id": "S4257387500340373",
      "text": "परेवा लाहाँचे अनि डाँफे मुनाल हुकुस",
      "audio": "audio/dev_06_1.wav",
      "sha256": "917533bcfba842a2eac3b66c389a0d4cf3ea80d71031839785fa0a684c2dd241",
      "split": "train",
      "automatic_leakage_label": null
    },
