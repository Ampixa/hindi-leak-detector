      "system": "audio8_r3",
      "sentence_id": "dev_09_0",
      "speaker_id": "S4256958500325615",
      "text": "अनि राम्रो कम्पनीको सामान लिनुहोस् अनि तपाईँहरूले चलाउनुहोस् तपाईँलाई धेरै लाभदायक हुनेछ",
      "audio": "audio/dev_09_0.wav",
      "sha256": "849cda442acdcd47ce40e12c2e1caf3c0511a4b5805d6b4833ee08c9238b4da6",
      "split": "train",
      "automatic_leakage_label": null
    },
