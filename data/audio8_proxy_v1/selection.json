      "clip_id": "0bf2e2465b2f2a9db97250c2",
      "system": "audio8_r3",
      "sentence_id": "dev_09_1",
      "speaker_id": "S4256958500325615",
      "text": "आज किनभने आफ्नो भाषा बाँच्यो भने चाहिँ आज सबै कुरो बाँच्ने छ आफ्नो भाषा बाँच्यो भने हाम्रो संस्कृति बाँच्छ",
      "audio": "audio/dev_09_1.wav",
