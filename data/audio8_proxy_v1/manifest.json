      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4259675300304689_013364.wav",
        "sha256": "3c9cf5e6e5fa49f4cddcf3934646b1d678d856c9edd925154aa1fe39d115514e",
        "text": "हुनसकेन त्यसले गर्दाखेरि त्यसमा पनि दुःख लागेको थियो लडाइँभन्दा पनि"
      }
    },
    {
      "id": "dev_09_0",
      "text": "अनि राम्रो कम्पनीको सामान लिनुहोस् अनि तपाईँहरूले चलाउनुहोस् तपाईँलाई धेरै लाभदायक हुनेछ",
      "speaker_id": "S4256958500325615",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4256958500325615_002961.wav",
        "sha256": "41db354a2216301901a494a354c09548ccf38fb8a6ab5ecde6b715c6a4857406",
        "text": "साथै विशेष गरी सेवा चालक सेवा क्या कार्यलयलाई म अनुरोध गर्दछु"
      }
    },
    {
      "id": "dev_09_1",
      "text": "आज किनभने आफ्नो भाषा बाँच्यो भने चाहिँ आज सबै कुरो बाँच्ने छ आफ्नो भाषा बाँच्यो भने हाम्रो संस्कृति बाँच्छ",
