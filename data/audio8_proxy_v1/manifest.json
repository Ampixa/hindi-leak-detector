  "jobs": [
    {
      "id": "dev_00_0",
      "text": "त्यस पश्चात् त मेरो मूलवासी चाहिँ म दार्जिलङको हो होइन दार्जिलिङकोमा गए पछि चाहिँ",
      "speaker_id": "S4259065500397435",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4259065500397435_005809.wav",
        "sha256": "b4dbd4e331d85f74be889c3f7e1670dafea35afcdf690388bb0827e625b8b949",
        "text": "मेरो पेटिएम वालेट सक्रिय गर्न कृपया मेरो प्यान कार्ड विवरणहरू भर्नुहोस्"
      }
    },
    {
      "id": "dev_00_1",
      "text": "चौधको दिउँसो के छ ताकि म दुई बर्से जम्ल्याहाहरूसित जान सकूँ",
      "speaker_id": "S4259065500397435",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4259065500397435_005809.wav",
        "sha256": "b4dbd4e331d85f74be889c3f7e1670dafea35afcdf690388bb0827e625b8b949",
        "text": "मेरो पेटिएम वालेट सक्रिय गर्न कृपया मेरो प्यान कार्ड विवरणहरू भर्नुहोस्"
      }
    },
    {
      "id": "dev_01_0",
      "text": "हाम्रो समुदायमा अभ्यासमा रहेका परम्परागत कृषि अभ्यासहरूको बारेमा बताउनु पर्दा",
      "speaker_id": "S4257751100369637",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4257751100369637_009829.wav",
        "sha256": "6ed10838a90596e8775880ff7a3116342079317d98b9ec29fe1737eaeebe9e6b",
        "text": "जन्मसिद्ध अधिकारको निम्ति चाहिँ झुक्दै नझुक्नु भन्ने खालको"
      }
    },
    {
      "id": "dev_01_1",
      "text": "जस्तै अब दौरा सुरुवालहरू ल लगाउँछन् हैन खुकुरी भिर्छन् खुकुरी भिर्ने चलन छ",
      "speaker_id": "S4257751100369637",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4257751100369637_009829.wav",
        "sha256": "6ed10838a90596e8775880ff7a3116342079317d98b9ec29fe1737eaeebe9e6b",
        "text": "जन्मसिद्ध अधिकारको निम्ति चाहिँ झुक्दै नझुक्नु भन्ने खालको"
      }
    },
    {
      "id": "dev_02_0",
      "text": "जुम्बा भन्ने एउटा डान्स छ त्यो हेरेर पनि हामीलाई राम्रो लाग्छ मतलब हाम्रो",
      "speaker_id": "S4258453800348915",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4258453800348915_004837.wav",
        "sha256": "cfdd0df3fe8e3c5760b4d7a59dc7e225508456516eab9281235f60dee0e3cf97",
        "text": "नेपाल भुटान बङलादेश श्रीलङ्का भारत"
      }
    },
    {
      "id": "dev_02_1",
      "text": "दार्जिलिङ कालिम्पोङ मालदा जलपाइगुडी अलिपुरद्वार",
      "speaker_id": "S4258453800348915",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4258453800348915_004837.wav",
        "sha256": "cfdd0df3fe8e3c5760b4d7a59dc7e225508456516eab9281235f60dee0e3cf97",
        "text": "नेपाल भुटान बङलादेश श्रीलङ्का भारत"
      }
    },
    {
      "id": "dev_03_0",
      "text": "यी सेवा संस्थानहरू स्वस्थ मुद्धाबारे अनि समाजको उत्थानबारे काम गर्ने गर्दछ",
      "speaker_id": "S4257298100347538",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4257298100347538_019650.wav",
        "sha256": "1b6bbab00edeae707ea083083875bc46c74b658cb2ac302084b6e5d8fe10a605",
        "text": "म सङ्गीत सुन्न रुचाउँछु मलाई आधुनिक प्रकारको सङ्गीत मन पर्छ"
      }
    },
    {
      "id": "dev_03_1",
      "text": "बेला भिटा अर्ग्यानिक आइलिफ्ट अन्डर आई क्रिम जेलमा यस अफरका लागि नियम र सर्तहरू के हुन्",
      "speaker_id": "S4257298100347538",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4257298100347538_019650.wav",
        "sha256": "1b6bbab00edeae707ea083083875bc46c74b658cb2ac302084b6e5d8fe10a605",
        "text": "म सङ्गीत सुन्न रुचाउँछु मलाई आधुनिक प्रकारको सङ्गीत मन पर्छ"
      }
    },
    {
      "id": "dev_04_0",
      "text": "बाँकुरा बिरभुम कुचबिहार दक्षिण दिनाजपुर मुर्सिदाबाद",
      "speaker_id": "S4258716800392755",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4258716800392755_018420.wav",
        "sha256": "f8e07c2a2204536aa7eabd42651434d166948a1c393cf1dc861132da0e36a72b",
        "text": "मैले तपाईँहरूको कालिम्पोङ ट्राभल एजेन्सीबाट एउटा गाडी बुक गरेको थिएँ अनि"
      }
    },
    {
      "id": "dev_04_1",
      "text": "मलाई चाहिँ पौडी खेल्नु क्रिकेट खेल्नु ट्रेकिङ",
      "speaker_id": "S4258716800392755",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4258716800392755_018420.wav",
        "sha256": "f8e07c2a2204536aa7eabd42651434d166948a1c393cf1dc861132da0e36a72b",
        "text": "मैले तपाईँहरूको कालिम्पोङ ट्राभल एजेन्सीबाट एउटा गाडी बुक गरेको थिएँ अनि"
      }
    },
    {
      "id": "dev_05_0",
      "text": "हुँदा हुँदै धेरै परिवर्तन आउँदै गए र अहिले पनि म तपाईँको यो",
      "speaker_id": "S4259477200361463",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4259477200361463_015355.wav",
        "sha256": "b3ce03a672bcb6eaf9859682766953f05055ade8277e6c23afd1b00efa038247",
        "text": "बाल्यकालमा हामी सबै मिली स्कुलको कुना काप्चामा गइ"
      }
    },
    {
      "id": "dev_05_1",
      "text": "जीवन धान्न त मैले स्वयम् मेरो बिचारमा त त्यति गाह्रो छैन जस्तो मलाई लाग्दछ धन्यवाद",
      "speaker_id": "S4259477200361463",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4259477200361463_015355.wav",
        "sha256": "b3ce03a672bcb6eaf9859682766953f05055ade8277e6c23afd1b00efa038247",
        "text": "बाल्यकालमा हामी सबै मिली स्कुलको कुना काप्चामा गइ"
      }
    },
    {
      "id": "dev_06_0",
      "text": "वाहकको रूमा पनि हेर्ने गरिन्छ र विशेष गरेर मलाई मनपर्ने ए चरामा चाहिँ काग पनि रहेको छ",
      "speaker_id": "S4257387500340373",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4257387500340373_011237.wav",
        "sha256": "68c1e148215f30f0a62f1092440ea42fb4eb924e654755763110a9ba3aeae7d1",
        "text": "ब यसको व्याकरण छुट्टै एउटा मौलिकतामा नेपाली भाषा आजको समय स्थितिसम्म आइपुगेको छ"
      }
    },
    {
      "id": "dev_06_1",
      "text": "परेवा लाहाँचे अनि डाँफे मुनाल हुकुस",
      "speaker_id": "S4257387500340373",
      "split": "train",
      "seed": 0,
      "reference": {
        "audio": "/home/ampixa/hindi-detector-proxy-v1/references/S4257387500340373_011237.wav",
